<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-gray-900">Uploaded Files</h1>

  <div class="flex items-center space-x-3">
    <!-- search -->
    <div class="relative">
      <input
          type="search"
          name="q"
          placeholder="Search files"
          class="block w-64 pl-3 pr-10 py-2 border border-gray-200 rounded-md shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          />
      <button class="absolute right-1 top-1/2 -translate-y-1/2 text-sm px-2 py-1 rounded-md">🔎</button>
    </div>

    <!-- upload button (example, link to new upload page) -->
    <%= link_to new_keyword_file_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-sky-900 text-white text-sm font-medium rounded-lg shadow hover:bg-sky-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-600" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v-1a4 4 0 014-4h8a4 4 0 014 4v1M12 12v9" /></svg>
      Upload File
    <% end %>
  </div>
</div>
<% if @keyword_files.present? %>
  <div class="bg-white shadow-sm overflow-hidden rounded-md">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">File</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden sm:table-cell">Size</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">Uploaded by</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden lg:table-cell">Uploaded at</th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>

      <tbody class="bg-white divide-y divide-gray-200">
        <% @keyword_files.each do |keyword_file| %>
          <tr>
            <!-- File name & icon -->
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center gap-3">
                <div class="flex-shrink-0 h-8 w-8 bg-gray-100 rounded-md flex items-center justify-center text-gray-500">
                  <!-- file icon -->
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h6l4 4v6a2 2 0 01-2 2H7a2 2 0 01-2-2V9a2 2 0 012-2z" /></svg>
                </div>
                <div class="text-sm">
                  <div class="font-medium text-gray-900"><%= keyword_file.name %></div>
                </div>
              </div>
            </td>

            <!-- Status badge -->
            <td class="px-6 py-4 whitespace-nowrap">
              <%# status badges: processing, completed, failed %>
              <% case u.status %>
              <% when "processing" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Processing</span>
              <% when "completed" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Completed</span>
              <% when "failed" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Failed</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= keyword_file.status || "Pending" %></span>
              <% end %>
            </td>

            <!-- Uploaded at -->
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden lg:table-cell">
              <%= l(keyword_file.created_at, format: :short) %>
            </td>

            <!-- Actions -->
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <div class="inline-flex items-center gap-2">
                <%= link_to upload_path(keyword_file), class: "px-3 py-1 rounded-md text-sm border border-gray-200 hover:bg-gray-50" do %>
                  View
                <% end %>

                <%= link_to download_upload_path(keyword_file), class: "px-3 py-1 rounded-md text-sm bg-indigo-50 text-indigo-700 hover:bg-indigo-100" do %>
                  Download
                <% end %>

                <!-- Delete using Turbo attributes with confirmation -->
                <%= link_to upload_path(keyword_file),
                  data: { turbo_method: :delete, turbo_confirm: "Delete #{u.name}? This action cannot be undone." },
                  class: "px-3 py-1 rounded-md text-sm bg-rose-50 text-rose-700 hover:bg-rose-100" do %>
                  Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="px-6 py-4">
    <p class="text-sm">No files uploaded yet.</p>
  </div>
<% end %>
