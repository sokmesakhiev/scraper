<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="text-center m-auto content-center">
    <h2 class="text-head text-dark-gray m-2">
      Reset your password
    </h2>
  </div>
  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <div>
        <label for="email" class="block text-sm/6 font-medium text-gray-100">Email address</label>
        <div class="mt-2">
          <%= f.email_field :email,
              autofocus: true,
              required: true,
              autocomplete: "email",
              class: "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" %>
        </div>
      </div>

      <div class="mt-10">
        <button type="submit" class="flex w-full justify-center rounded-md bg-indigo-500 px-3 py-1.5 text-sm/6 font-semibold text-white hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">Send me password reset instructions</button>
      </div>
    <% end %>
  </div>
</div>
