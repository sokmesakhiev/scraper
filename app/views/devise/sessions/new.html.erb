<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="text-center m-auto content-center">
    <h2 class="text-head text-dark-gray m-2">
      Sign in to Bing Scraper
    </h2>
  </div>
  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
    <%= form_with(scope: :user, url: session_path(:user), class: "space-y-6") do |f| %>
      <div>
        <label for="email" class="block text-sm/6 font-medium text-gray-100">Email address</label>
        <div class="mt-2">
          <%= f.email_field :email,
              autofocus: true,
              required: true,
              autocomplete: "email",
              class: "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" %>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between">
          <label for="password" class="block text-sm/6 font-medium text-gray-100">Password</label>
          <div class="text-sm">
            <%= link_to "Forgot password?", new_password_path(:user), class: "font-semibold text-indigo-400 hover:text-indigo-300" %>
          </div>
        </div>
        <div class="mt-2">
          <%= f.password_field :password,
              autocomplete: "current-password",
              required: true,
              class: "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6"
          %>
        </div>
      </div>

      <div>
        <button type="submit" class="flex w-full justify-center rounded-md bg-indigo-500 px-3 py-1.5 text-sm/6 font-semibold text-white hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500">Sign in</button>
      </div>
    <% end %>

    <div class="flex mt-10 items-center text-center">
      <hr class="border-white border-1 w-full rounded-md">
      <label class="block font-medium text-sm w-full text-white">
        Or continue with
      </label>
      <hr class="border-white border-1 w-full rounded-md">
    </div>

    <div class="flex justify-center items-center btn btn-text w-full mt-10">
      <div class="flex items-center space-x-4">
        <img src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/brand-logo/google-icon.png" alt="google icon" class="w-16 h-16 object-contain">
        <%= link_to "Sign in with Google", user_google_oauth2_omniauth_authorize_path, class: "py-2 text-white rounded" %>
      </div>
    </div>

    <p class="mt-10 text-center text-sm/6 text-gray-400">
      Not a member?
      <%= link_to "Sign up", new_user_registration_path(), class: "font-semibold text-indigo-400 hover:text-indigo-300" %>
    </p>
  </div>
</div>
