<div id="uploadModal" data-upload-modal-target="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-gray-900/50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-6 relative">
    <button
        type="button"
        data-action="click->upload-modal#close"
        class="absolute top-3 right-3 text-gray-400 hover:text-gray-600"
        ></button>

    <h2 class="text-lg font-semibold text-gray-800 mb-4">Upload a New File</h2>

    <%= form_with model: KeywordFile.new, url: keyword_files_path, multipart: true, format: :turbo_stream, data: { turbo_frame: "upload_form" }, local: false do |form| %>
      <div class="space-y-4">
        <div id="upload_errors">
          <% if defined?(errors) && errors.present? %>
            <div class="bg-red-100 text-red-700 rounded">
              <ul>
                <% errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
        <div>
          <%= form.label :file, "Select file", class: "block text-sm font-medium text-gray-700" %>
          <%= form.file_field :file, required: true, class: "mt-1 block w-full text-sm text-gray-700 border border-gray-300 rounded-md cursor-pointer focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div class="flex justify-end space-x-3 pt-4">
          <button type="button"
                  data-action="click->upload-modal#close"
                  class="px-4 py-2 text-sm border border-gray-200 rounded-md text-gray-600 hover:bg-gray-50">
                  Cancel
          </button>
          <%= form.submit "Upload", class: "px-4 py-2 text-sm font-medium text-white bg-sky-900 rounded-md shadow hover:bg-sky-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-600" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
