<nav class="flex mb-6" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
    <li class="inline-flex items-center">
      <%= link_to root_path, class: "inline-flex items-center text-sm font-medium text-gray-400 dark:text-gray-400 dark:hover:text-white" do %>
        <svg class="w-3 h-3 me-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
        </svg>
        Home
      <% end %>
    </li>
    <li>
      <div class="flex items-center">
        <svg class="rtl:rotate-180 w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
        </svg>
        <%= link_to keyword_files_path, class: "inline-flex items-center text-sm font-medium text-gray-400 dark:text-gray-400 dark:hover:text-white" do %>
          Files
        <% end %>
      </div>
    </li>
    <li aria-current="page">
      <div class="flex items-center">
        <svg class="rtl:rotate-180 w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
        </svg>
        <span class="ms-1 text-sm font-medium text-gray-300 md:ms-2 dark:text-gray-400"><%= @keyword_file.name %></span>
      </div>
    </li>
  </ol>
</nav>
<div class="flex items-center justify-between mb-6 mt-2">
  <h1 class="text-2xl font-semibold text-gray-200">Keywords</h1>

  <div class="flex items-center">
    <%= form_with url: keyword_file_path(@keyword_file), method: :get, class: "relative w-full sm:w-auto pr-3" do |form| %>
      <%= form.text_field :query,
            value: params[:query],
            placeholder: "Search files...",
            class: "block w-full sm:w-64 pl-3 pr-10 py-2 border border-gray-200 rounded-md shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 pr-3">
        🔍
      </button>
    <% end %>
  </div>
</div>

<turbo-frame id="keyword_files_table" data-turbo-action="replace" class="block max-h-[800px] overflow-y-auto bg-sky-900 rounded-lg shadow">
  <% if @keywords.present? %>
    <%= render "keywords/table", keywords: @keywords %>
  <% else %>
    <div class="px-6 py-4">
      <p class="text-sm">No keywords ...</p>
    </div>
  <% end %>
</turbo-frame>
