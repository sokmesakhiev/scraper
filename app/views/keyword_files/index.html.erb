<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-gray-900">Uploaded Files</h1>

  <div class="flex items-center">
    <%= form_with url: keyword_files_path, method: :get, class: "relative w-full sm:w-auto pr-3" do |form| %>
      <%= form.text_field :query,
            value: params[:query],
            placeholder: "Search files...",
            class: "block w-full sm:w-64 pl-3 pr-10 py-2 border border-gray-200 rounded-md shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 pr-3">
        🔍
      </button>
    <% end %>
    <div data-controller="upload-modal">
      <%= render "upload_file" %>

      <button
          type="button"
          data-action="click->upload-modal#open"
          class="cursor-pointer inline-flex items-center gap-2 px-4 py-2 bg-sky-900 text-white text-sm font-medium rounded-lg shadow hover:bg-sky-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v-1a4 4 0 014-4h8a4 4 0 014 4v1M12 12v9" /></svg>
          Upload File
      </button>
    </div>
  </div>
</div>

<turbo-frame id="keyword_files_table" data-turbo-action="replace" class="block max-h-[800px] overflow-y-auto bg-sky-900 rounded-lg shadow">
  <% if @keyword_files.present? %>
    <%= render "keyword_files/table", keyword_files: @keyword_files %>
  <% else %>
    <div class="px-6 py-4">
      <p class="text-sm">No files uploaded ...</p>
    </div>
  <% end %>
</turbo-frame>
