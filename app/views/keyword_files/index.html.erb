<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-gray-900">Uploaded Files</h1>

  <div class="flex items-center space-x-3">
    <%= form_with url: keyword_files_path, method: :get, class: "relative w-full sm:w-auto" do |form| %>
      <%= form.text_field :q,
            value: params[:q],
            placeholder: "Search files...",
            class: "block w-full sm:w-64 pl-3 pr-10 py-2 border border-gray-200 rounded-md shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 pl-2">
        🔍
      </button>
    <% end %>

    <%= link_to new_keyword_file_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-sky-900 text-white text-sm font-medium rounded-lg shadow hover:bg-sky-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-600" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v-1a4 4 0 014-4h8a4 4 0 014 4v1M12 12v9" /></svg>
      Upload File
    <% end %>
    <button
        type="button"
        data-action="click->upload-modal#open"
        class="cursor-pointer inline-flex items-center gap-2 px-4 py-2 bg-sky-900 text-white text-sm font-medium rounded-lg shadow hover:bg-sky-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v-1a4 4 0 014-4h8a4 4 0 014 4v1M12 12v9" /></svg>
          Upload File
    </button>

    <div id="uploadModal" data-controller="upload-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-gray-900/50">
      <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-6 relative">
        <button
          type="button"
          data-action="click->upload-modal#close"
          class="absolute top-3 right-3 text-gray-400 hover:text-gray-600"
        ></button>

        <h2 class="text-lg font-semibold text-gray-800 mb-4">Upload a New File</h2>

        <%= form_with model: KeywordFile.new, url: keyword_files_path, html: { multipart: true, data: { turbo_frame: "_top" } } do |form| %>
          <div class="space-y-4">
            <div>
              <%= form.label :file, "Select file", class: "block text-sm font-medium text-gray-700" %>
              <%= form.file_field :file, class: "mt-1 block w-full text-sm text-gray-700 border border-gray-300 rounded-md cursor-pointer focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>

            <div class="flex justify-end space-x-3 pt-4">
              <button type="button"
                      data-action="click->upload-modal#close"
                      class="px-4 py-2 text-sm border border-gray-200 rounded-md text-gray-600 hover:bg-gray-50">
                Cancel
              </button>
              <%= form.submit "Upload", class: "px-4 py-2 text-sm font-medium text-white bg-sky-900 rounded-md shadow hover:bg-sky-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-600" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<turbo-frame id="keyword_files_table" class="block max-h-[600px] overflow-y-auto p-4 bg-gray-50 rounded-lg shadow">
  <%= render "table", keyword_files: @keyword_files %>
</turbo-frame>
